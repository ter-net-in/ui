    {
      "name": "theme",
      "type": "registry:style",
      "title": "Theme",
      "description": "internet-ui design tokens (Tailwind v4). Import once from your global stylesheet.",
      "dependencies": ["tailwindcss", "tw-animate-css"],
      "files": [
        {
          "path": "registry/internet/theme/globals.css",
          "type": "registry:style",
          "target": "app/globals.css"
        }
      ]
    },
    {
      "name": "utils",
