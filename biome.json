{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/deploy",
      "!**/.next",
      "!**/out",
      "!**/storybook-static",
      "!apps/docs/public",
      "!**/*.min.js"
    ]
  },
  "formatter": { "enabled": true, "lineWidth": 120, "indentStyle": "space", "indentWidth": 2 },
  "linter": { "enabled": true, "rules": { "preset": "none" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "javascript": { "formatter": { "quoteStyle": "single", "trailingCommas": "none" } }
}
