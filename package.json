{
  "name": "internet-ui",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@internet-ui/docs' dev",
    "build": "bun run --filter '*' build",
    "build:registry": "bun run scripts/registry/build-registry.ts",
    "build:cli": "bun run --filter '@ternetin/ui' build",
    "publish:cli": "bun run build:cli && npm publish --workspace @ternetin/ui --access public",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "^5.9.3",
    "@biomejs/biome": "^2.6.4"
  },
  "overrides": {
    "postcss": "^8.5.32",
    "webpack-dev-middleware": "^7.4.5"
  }
}
