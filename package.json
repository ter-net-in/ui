{
  "name": "internet-ui",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@internet-ui/docs' dev",
    "build": "bun run --filter '*' build",
    "build:registry": "bun run --filter '@internet-ui/docs' build:registry",
    "build:cli": "bun run --filter 'internet-ui' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@types/bun": "^1.2.16",
    "typescript": "^5.8.3",
    "@biomejs/biome": "^2.4.15"
  }
}
