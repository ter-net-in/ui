{
  "$schema": "https://ui.ter.net.in/schema/registry.json",
  "name": "internet-ui",
  "homepage": "https://ui.ter.net.in",
  "items": [
    {
      "name": "theme",
      "type": "registry:style",
      "title": "Theme",
      "description": "internet-ui design tokens (Tailwind v4). Import once from your global stylesheet.",
      "dependencies": ["tailwindcss", "tw-animate-css"],
      "files": [
        {
          "path": "src/theme/globals.css",
          "type": "registry:style",
          "target": "app/globals.css"
        }
      ]
    },
    {
      "name": "ui-defaults",
      "type": "registry:lib",
      "title": "Variant defaults",
      "description": "Project-wide default radius and shadow. Values are substituted from the `defaults` block of internet-ui.json at install time.",
      "dependencies": [],
      "registryDependencies": [],
      "files": [
        {
          "path": "src/lib/ui-defaults.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "cn utility",
      "description": "clsx + tailwind-merge class combiner and shared radius variants used by every component.",
      "dependencies": ["clsx", "tailwind-merge", "class-variance-authority"],
      "files": [
        {
          "path": "src/lib/utils.ts",
          "type": "registry:lib"
        }
      ],
      "registryDependencies": ["ui-defaults"]
    },
    {
      "name": "motion",
      "type": "registry:lib",
      "title": "Motion presets",
      "description": "Shared animation language: easing curves, duration and spring tokens, and the render-prop helpers that animate Base UI popups with Motion.",
